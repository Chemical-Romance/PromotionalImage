# ===== PromoStudio AI 代理配置 =====
# 复制此文件为 .env 后填入真实值。API Key 仅存于服务器，永不暴露到浏览器。

# ---- 选择一个 LLM 提供商，填入对应的 Base URL 和 Model ----

# 1. OpenAI 官方
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# 2. 火山方舟（豆包）—— 需先在方舟控制台创建推理接入点，复制 Base URL
# AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# AI_MODEL=doubao-1-5-vision-pro-32k-250115

# 3. 阿里云百炼（通义）
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-vl-max

# 4. DeepSeek
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

# ---- API Key ----
# 在对应平台申请后填入。Docker Compose 会把这个文件 mount 进代理容器。
AI_API_KEY=sk-REPLACE_WITH_YOUR_REAL_KEY

# ---- 代理端口（容器内部） ----
AI_PROXY_PORT=3100
